APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Logging.
#
# Debug output is written with Log::debug() / Log::info() / etc, never with
# dd(), dump(), var_dump() or print_r(). To quieten a server, change LOG_LEVEL
# below. Never delete the Log:: lines from the code.
#
# LOG_LEVEL controls what actually gets written. Anything below the level set
# here is dropped. Order, quietest last:
#   debug < info < notice < warning < error < critical < alert < emergency
#
# LOG_CHANNEL=daily rotates to a new file each day and keeps 14 days.
#   'single' writes one laravel.log that grows forever - fine locally, bad on
#   a server.
#
# ---- LOCAL / DEV (these values) ----
#   APP_ENV=local  APP_DEBUG=true   LOG_CHANNEL=stack  LOG_LEVEL=debug
#
# ---- PRODUCTION (set these in the production .env) ----
#   APP_ENV=production
#   APP_DEBUG=false          <- also what hides the debug bar. Must be false.
#   LOG_CHANNEL=daily
#   LOG_LEVEL=warning        <- Log::debug() and Log::info() go silent
#
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Debug bar (barryvdh/laravel-debugbar).
#
# Three locks keep it off a public server, and this variable is the outer one.
# The other two are in code: a local-only wrapper provider that registers the
# package only when APP_DEBUG is true AND trim(APP_ENV) === 'local', and
# composer auto-discovery for the package switched off.
#
# ---- LOCAL / DEV (these values) ----
#   DEBUGBAR_ENABLED=true
#   DEBUGBAR_OPEN_STORAGE=false   <- never expose stored requests over HTTP
#
# ---- PRODUCTION (set these in the production .env) ----
#   DEBUGBAR_ENABLED=false        <- must be false. Belt as well as braces:
#                                    APP_DEBUG=false already hides it.
#   DEBUGBAR_OPEN_STORAGE=false
#
DEBUGBAR_ENABLED=true
DEBUGBAR_OPEN_STORAGE=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
