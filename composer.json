{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The skeleton application for the Laravel framework.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.1 | ^7.4",
    "barryvdh/laravel-dompdf": "v3.1.1",
    "google/apiclient": "*",
    "guzzlehttp/guzzle": "^7.2",
    "laravel/framework": "^10.0",
    "laravel/sanctum": "^3.2",
    "laravel/tinker": "^2.8",
    "maatwebsite/excel": "*",
    "microsoft/microsoft-graph": "v2.43.0",
    "nwidart/laravel-modules": "^10.0",
    "phpoffice/phpspreadsheet": "*",
    "phpoffice/phpword": "1.3.0",
    "setasign/fpdi": "v2.6.3",
    "spatie/pdf-to-text": "1.54.0",
    "symfony/polyfill-iconv": "v1.32.0",
    "tecnickcom/tcpdf": "6.3.1"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^3.9",
    "fakerphp/faker": "^1.9.1",
    "laravel/pint": "^1.0",
    "laravel/sail": "^1.25",
    "mockery/mockery": "^1.4.4",
    "nunomaduro/collision": "^7.0",
    "phpunit/phpunit": "^10.1",
    "spatie/laravel-ignition": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/",
      "Modules\\": "Modules/",
      "Modules\\ApprovalRules\\": "Modules/ApprovalRules/app/",
      "Modules\\ApprovalRules\\Database\\Factories\\": "Modules/ApprovalRules/database/factories/",
      "Modules\\ApprovalRules\\Database\\Seeders\\": "Modules/ApprovalRules/database/seeders/",
      "Modules\\ContractParties\\": "Modules/ContractParties/app/",
      "Modules\\ContractParties\\Database\\Factories\\": "Modules/ContractParties/database/factories/",
      "Modules\\ContractParties\\Database\\Seeders\\": "Modules/ContractParties/database/seeders/",
      "Modules\\Contract\\": "Modules/Contract/app/",
      "Modules\\Contract\\Database\\Factories\\": "Modules/Contract/database/factories/",
      "Modules\\Contract\\Database\\Seeders\\": "Modules/Contract/database/seeders/",
      "Modules\\Contractsetup\\": "Modules/Contractsetup/app/",
      "Modules\\Contractsetup\\Database\\Factories\\": "Modules/Contractsetup/database/factories/",
      "Modules\\Contractsetup\\Database\\Seeders\\": "Modules/Contractsetup/database/seeders/",
      "Modules\\Tasks\\": "Modules/Tasks/app/",
      "Modules\\Tasks\\Database\\Factories\\": "Modules/Tasks/database/factories/",
      "Modules\\Tasks\\Database\\Seeders\\": "Modules/Tasks/database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "files": [
      "app/Helpers/Helpers.php",
      "app/helpers.php"
    ]
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "barryvdh/laravel-debugbar"
      ]
    },
    "merge-plugin": {
      "include": [
        "Modules/*/composer.json"
      ]
    }
  },
  "config": {
    "optimize-autoloader": false,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "tbachert/spi": true,
      "wikimedia/composer-merge-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "platform-check": false
}
