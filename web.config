<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.web>
        <httpRuntime maxRequestLength="2147483647" requestLengthDiskThreshold="2147483647" executionTimeout="24000" />
    </system.web>
    <system.webServer>
            <security>
                <requestFiltering>
                    <requestLimits maxAllowedContentLength="4294967295" />
                </requestFiltering>
        </security>
        <defaultDocument>
            <files>
            <clear />
                <add value="index.php" />
                <add value="index.html" />
                <add value="index.htm" />
                <add value="Default.htm" />
                <add value="Default.asp" />
                <add value="iisstart.htm" />
            </files>
        </defaultDocument>
    
        <rewrite>
            <rules>
                <!--
                  A missing STATIC file must 404 here, not inside PHP.

                  Without this rule the Laravel rule below rewrites every non-existent path to
                  index.php, so a single missing stylesheet boots the whole framework to render a
                  404 page. Measured on this server: /assets/fonts/font-main.css cost 2,104-3,286 ms
                  of bootstrap per page load, and with opcache off that is paid every time.

                  This rule runs FIRST and stops processing, so a request for a static-looking path
                  that is not on disk is answered by IIS in microseconds.

                  Checked against %windir%\System32\inetsrv\config\schema\rewrite_schema.xml before
                  being written: action type "CustomResponse" exists (value 3) and statusCode /
                  subStatusCode / statusReason / statusDescription are all valid attributes.
                  statusCode validation excludes 300-307 only, so 404 is accepted.

                  Extension list note: ".json" is included, and it is safe here - no route in this
                  application ends in .json (checked across routes/ and Modules/*/routes/). Real JSON
                  assets such as assets/json/search-vertical.json exist on disk, so they never reach
                  this rule. If a .json ROUTE is ever added, remove json from the list below.

                  This changes nothing for paths that DO exist, and nothing for normal Laravel URLs,
                  which have no file extension.
                -->
                <!--
                  Serve /contracts/build/* from the public/build folder.

                  WHY. Laravel reads the Vite manifest from public/build/manifest.json
                  (public_path() is contracts/public), but it writes asset URLs as
                  /contracts/build/... - which IIS was answering from a SECOND, separate 33 MB copy
                  at the app root. Two copies, nothing keeping them in step, and they had already
                  drifted: different entry counts, crossed app.css/app.js entries, and one
                  hand-typed path with a spelling error. A rebuild wrote one folder and not the
                  other, so four files would have 404'd - datatables-bootstrap5 among them, which
                  56 blades need.

                  This rule points the URL at the folder Laravel actually reads, so there is one
                  copy and `npm run build` is enough on its own.

                  ORDER MATTERS. It must sit ABOVE the "static file 404" rule below. That rule has
                  stopProcessing and fires on any missing .css/.js path, so once the root build/
                  folder goes away it would 404 every asset before this rule could run.

                  The Cache-Control rule for these files is a <location path="public/build/assets">
                  block at the end of this file. Note the path: <location> matches AFTER this
                  rewrite, not the URL the browser asked for. With path="build/assets" the
                  Cache-Control header vanished completely - measured, then fixed.
                -->
                <rule name="build assets served from public/build" stopProcessing="true">
                    <match url="^build/(.*)$" ignoreCase="true" />
                    <action type="Rewrite" url="public/build/{R:1}" />
                </rule>
                <rule name="static file 404 without booting PHP" stopProcessing="true">
                    <match url="\.(css|js|mjs|map|png|jpe?g|gif|bmp|svg|webp|avif|ico|woff|woff2|ttf|eot|otf|json|txt|xml|mp3|mp4|webm|ogg|wav|pdf|zip)$" ignoreCase="true" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="CustomResponse" statusCode="404" subStatusCode="0" statusReason="Not Found" statusDescription="Static file not found" />
                </rule>
                <rule name="imported rule 3" stopProcessing="true">
                    <match url="^(.*)$" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php/{R:1}" />
                </rule>     
            </rules>
        </rewrite>
    </system.webServer>

    <!--
      Cache-Control for the Vite build output only. Ticket 22 / ticket 21, applied 2026-08-21.

      SCOPED WITH A LOCATION PATH, on purpose. Everything under build/assets carries a content
      hash in its filename (core-7_a25xA8.css) - checked, all 1,046 files, no exceptions - so the
      name changes whenever the bytes change and a stale cache cannot happen. That is what makes
      "immutable, one year" safe there.

      It must NOT apply to the whole folder tree. assets/ and images/ hold files whose names never
      change; a one-year immutable cache on those would pin a changed logo or stylesheet in every
      existing browser. config-proposals/web.config.proposed put the block at this file's top
      level, which would have done exactly that. This is the corrected form.

      It also cannot live in build/assets/web.config, which was the first attempt: /build is
      git-ignored and completely untracked, so that file would never reach a server.

      PATH IS public/build/assets, NOT build/assets. Changed 2026-08-21 when the rewrite rule above
      started serving /contracts/build/* from public/build. <location> matches the path AFTER the
      rewrite, not the URL the browser asked for - measured, not assumed: with path="build/assets"
      the Cache-Control header disappeared completely.

      WHAT IT FIXES
        These files send an ETag and no Cache-Control, so a returning visitor makes a conditional
        request per file and waits for a 304 on each - 54 round-trips before the page can finish.
        This removes all of them. It saves nothing on a first visit.

      ATTRIBUTES CHECKED against %windir%\System32\inetsrv\config\schema\IIS_schema.xml:
        clientCache          element, line 1429
        cacheControlMode     enum, "UseMaxAge" valid, line 1433
        cacheControlMaxAge   timeSpan, "365.00:00:00" valid
        cacheControlCustom   string, "immutable" valid
      This check is mandatory: an unchecked attribute name took the whole site down with HTTP
      500.19 once already. See .scratch/contracts-dashboard-perf/config-proposals/.

      IF THIS CAUSES HTTP 500.19
        The parent GOAL application has locked system.webServer/staticContent. Delete this
        <location> block and the file is back to what it was. Nothing else depends on it.
    -->
    <!--
      Declare the charset on every stylesheet this application serves.

      WHAT WAS WRONG. The Vite icon stylesheets put the glyph in as RAW UTF-8 BYTES, not as a
      backslash-f015 escape - checked, tabler-icons-XUw5yIc1.css holds content:"<EF 95 94>". IIS mapped
      .css to "text/css" with NO charset (applicationHost.config line 497), and a stylesheet that
      declares no charset of its own borrows the encoding of the page that links it. Whenever that
      borrowing does not happen, the browser reads those bytes as Latin-1 and every icon on the
      page turns into mojibake - the sidebar reads "iEUR-Dashboard" instead of showing an icon.
      Reported twice now.

      This makes the stylesheet say what it is, so nothing has to be inferred.

      SAFE FOR EVERY CSS FILE HERE: all 108 stylesheets in the repo were read as UTF-8 first and
      all 108 decode cleanly, so none of them is Latin-1 that this would break.

      ATTRIBUTES CHECKED against %windir%\System32\inetsrv\config\schema\IIS_schema.xml, section
      system.webServer/staticContent, line 1444:
        mimeMap        addElement of the collection
        remove         removeElement of the same collection
        fileExtension  string, required, unique key
        mimeType       string, required, nonEmptyString
      The section is overridable: applicationHost.config line 92 has
        <section name="staticContent" overrideModeDefault="Allow" />
      This check is mandatory here - an unchecked attribute name took the whole site down with
      HTTP 500.19 once already.

      IF THIS CAUSES HTTP 500.19
        The parent GOAL application has locked staticContent lower down. Delete this
        <staticContent> block and the file is back to what it was. Nothing else depends on it.
    -->
    <location path=".">
        <system.webServer>
            <staticContent>
                <remove fileExtension=".css" />
                <mimeMap fileExtension=".css" mimeType="text/css; charset=utf-8" />
            </staticContent>
        </system.webServer>
    </location>

    <location path="public/build/assets">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge"
                             cacheControlMaxAge="365.00:00:00"
                             cacheControlCustom="immutable" />
            </staticContent>
        </system.webServer>
    </location>
</configuration>