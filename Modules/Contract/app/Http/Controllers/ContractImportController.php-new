                        $signing_date = $chaildval[15];

                        $currency = $chaildval[16];

                        $currency_value = $chaildval[17];
                        $payment_schedule = $chaildval[18];

                        $payment_terms = $chaildval[19];
                        $billing_frequency = $chaildval[17];

                        $taxes = $chaildval[18];
                        $escalation_clauses = $chaildval[19];
                        $discounts = $chaildval[20];
                        $retention = $chaildval[21];
                        $payment_escrow = $chaildval[22];
                        $financial_guarantees = $chaildval[23];


                        // return $chaildval;


                        $contract = Contract::create([
                            'contract_mode' => 'old',
